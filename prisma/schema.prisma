// Barber shop — modelo inicial. Ajustaremos reglas de solapamiento y zonas horarias en iteraciones siguientes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Barber {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  weeklyAvailabilities WeeklyAvailability[]
  timeOffs             TimeOff[]
  appointments         Appointment[]
}

/// Franja recurrente; dayOfWeek: 0 = lunes … 6 = domingo
model WeeklyAvailability {
  id        String @id @default(cuid())
  barberId  String
  barber    Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String

  @@index([barberId])
}

model TimeOff {
  id       String   @id @default(cuid())
  barberId String
  barber   Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  startsAt DateTime
  endsAt   DateTime

  @@index([barberId, startsAt])
}

model Service {
  id              String   @id @default(cuid())
  name            String
  durationMinutes Int
  priceCents      Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointments Appointment[]
}

model Appointment {
  id              String            @id @default(cuid())
  barberId        String
  barber          Barber            @relation(fields: [barberId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service           @relation(fields: [serviceId], references: [id])
  startsAt        DateTime
  endsAt          DateTime
  customerName    String
  customerEmail   String?
  customerPhone   String?
  status          AppointmentStatus @default(CONFIRMED)
  createdAt       DateTime          @default(now())

  @@index([barberId, startsAt])
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  NO_SHOW
}
